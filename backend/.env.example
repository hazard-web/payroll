PORT=5000

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/payslip_generator?retryWrites=true&w=majority

# Gmail SMTP Configuration for Emailing Payslips and Invitations
# Generate EMAIL_PASS at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
# Note: EMAIL_USER and EMAIL_FROM should match the sending email address.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM=your_gmail_address@gmail.com

# Frontend and Application URL (Used for generating links inside emails)
# Set both to your production domain (e.g. https://your-app.vercel.app).
# Avoid using temporary Vercel preview/deployment URLs here.
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Email Verification Setup
# Set to 'true' to skip email verification checks during registration/onboarding.
SKIP_EMAIL_VERIFICATION=false

# JSON Web Token Secret (used for signing and verifying auth tokens)
JWT_SECRET=your_secure_jwt_secret_key_here

# Cloudinary Configuration (Optional)
# If these are configured, the app will upload KYC and logo files to Cloudinary.
# If left blank, the app will fall back to storing files as base64 strings in MongoDB.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
