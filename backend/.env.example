PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/payslip_generator?retryWrites=true&w=majority

# Gmail SMTP
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="PaySlip Pro" <your_email@gmail.com>

# Frontend URL
# In Vercel production, set both values to your live frontend domain.
# IMPORTANT: These must be your PRODUCTION domain only, never preview URLs.
FRONTEND_URL=https://rohit98k-payroll-portal.vercel.app
APP_URL=https://rohit98k-payroll-portal.vercel.app

# Permanent production domain for invitations
# This is the ONLY domain used for invitation/verification links.
# It must never change, even when the application is redeployed.
PRODUCTION_DOMAIN=https://rohit98k-payroll-portal.vercel.app

# Email Verification
SKIP_EMAIL_VERIFICATION=true

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
