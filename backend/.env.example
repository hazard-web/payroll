PORT=5001

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/payslip_generator?retryWrites=true&w=majority

# Gmail SMTP Configuration for Emailing Payslips and Invitations
# Generate EMAIL_PASS at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
# Note: EMAIL_USER and EMAIL_FROM should match the sending email address.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM=your_gmail_address@gmail.com

# Hostinger API-only: leave false. Frontend is deployed on Vercel.
SERVE_FRONTEND=false
NODE_ENV=production
# UAT vs prod on the same VPS: people-os-api-uat / people-os-api
PM2_APP_NAME=people-os-api

# Frontend and Application URL (Used for generating links inside emails)
# UAT/prod: your Vercel frontend origin (no trailing slash).
FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3001

# Email Verification Setup
# Set to 'true' to skip email verification checks during registration/onboarding.
SKIP_EMAIL_VERIFICATION=false

# Allowed sign-in domain (invite-only). Personal Gmail etc. cannot sign in.
ALLOWED_EMAIL_DOMAIN=bda.co.in

# JSON Web Token Secret (used for signing and verifying auth tokens)
JWT_SECRET=your_secure_jwt_secret_key_here

# ── Social Sign-in ("Sign in using") ──────────────────────────
# Add CLIENT_ID + CLIENT_SECRET for each provider you want live.
# Callback URL to register at every provider console:
#   {BACKEND_URL}/api/auth/oauth/{provider}/callback
# Providers: google | facebook | linkedin | x | apple | microsoft | github | gitlab
# Example local callback:
#   http://localhost:5001/api/auth/oauth/google/callback
#
# FRONTEND_URL must match the app origin (OAuth returns here):
#   http://localhost:3001/oauth/callback
# Public API origin (Hostinger). OAuth callback is:
#   {BACKEND_URL}/api/auth/oauth/{provider}/callback
BACKEND_URL=http://localhost:5001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: import Google Account "Sign in with Google" apps into the launcher.
# Sign in with Google (email/profile) cannot read myaccount.google.com linked apps.
# Use a Workspace admin service account with domain-wide delegation and
# scope https://www.googleapis.com/auth/admin.directory.user.security
# GOOGLE_WORKSPACE_SA_JSON={"type":"service_account",...}
# GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@bda.co.in

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Cloudinary Configuration (Optional)
# If these are configured, the app will upload KYC and logo files to Cloudinary.
# If left blank, the app will fall back to storing files as base64 strings in MongoDB.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
