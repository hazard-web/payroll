{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/attendance/cron/office-closing-reminder",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/attendance/cron/office-closing-auto-close",
      "schedule": "0 14 * * *"
    }
  ]
}
