{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          "backend/**",
          "frontend/**"
        ]
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/$1"
    }
  ],
  "env": {
    "VERCEL": "true"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": [
        "dist/**",
        "backend/**",
        "frontend/**"
      ]
    }
  }
}